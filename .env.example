OLLAMA_URL=http://127.0.0.1:11434
ANDY_MODEL=gemma3:4b
PORT=8000
# Desktop-only optional overrides:
# ANDY_VOICE_MODEL=/absolute/path/to/vosk-model-small-en-us-0.15
# ANDY_INPUT_DEVICE=0

# Local English speech, downloaded by install-desktop.sh:
# ANDY_SPEECH_MODEL=small
# ANDY_SPEECH_LANGUAGE=en

# Online soft female English voice; set engine=espeak for offline backup:
# ANDY_TTS_ENGINE=edge
# ANDY_TTS_VOICE=en-IN-NeerjaNeural
# ANDY_TTS_RATE=-8%
# Live weather defaults to your selected city:
# ANDY_WEATHER_CITY=Hyderabad, India
