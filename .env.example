OLLAMA_URL=http://127.0.0.1:11434
ANDY_MODEL=gemma3:4b
PORT=8000
# Desktop-only optional overrides:
# ANDY_VOICE_MODEL=/absolute/path/to/vosk-model-small-en-us-0.15
# ANDY_INPUT_DEVICE=0

# Local English speech, downloaded by install-desktop.sh:
# ANDY_SPEECH_MODEL=small
# ANDY_SPEECH_LANGUAGE=en

# Online soft female English voice; set engine=espeak for offline backup:
# ANDY_TTS_ENGINE=edge
# ANDY_TTS_VOICE=en-IN-NeerjaNeural
# ANDY_TTS_RATE=-8%
# Live weather defaults to your selected city:
# ANDY_WEATHER_CITY=Hyderabad, India

# Local music folder (defaults to ~/Music):
# ANDY_MUSIC_DIR=/home/your-user/Music

# AI inference routing: local, hybrid, or cloud. Hybrid defaults to local
# until an API key is supplied through the native Cloud AI settings dialog.
# ANDY_AI_MODE=hybrid
# ANDY_CLOUD_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=  # configure in your PC environment; never commit a real key

# Webcam snapshots always require fresh permission in the app:
# ANDY_CAMERA_DEVICE=/dev/video0
